# Dependencies
node_modules

# Build output
dist

# Environment / secrets — never commit
# `.env.keys` holds the dotenvx PRIVATE key. If git ever reports it as
# ignored, that is the guard working correctly — never `git add -f` it.
# Adding `-f` is exactly how the original leak happened.
.env
.env.local
.env.*.local
.env.keys
**/.env.keys
*.pem

# Capacitor / Android build outputs
android/.gradle
android/app/build
android/build
android/local.properties
android/app/src/main/assets/public
android/capacitor-cordova-android-plugins

# Signing keys — never commit
*.keystore
*.jks
keystore.properties

# Native IDE files
android/.idea
android/*.iml
android/local.properties
android/captures
android/.cxx

# OS noise
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
bun.lock.bak

# Test/build artifacts
coverage
tsconfig.app.tsbuildinfo
tsconfig.node.tsbuildinfo

# Prebuilt APKs — never commit.
# A debug APK ships a WebView with remote debugging enabled and exposes the
# whole app's traffic to anyone who can attach DevTools. Publish release
# artefacts through GitHub Releases, built by a signed CI job.
apks/*.apk
