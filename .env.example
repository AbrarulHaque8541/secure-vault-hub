# Convex deployment URL - replace with your actual deployment URL
# Run 'npx convex dev' to get the development URL
VITE_CONVEX_URL=

# Convex site URL for auth
CONVEX_SITE_URL=http://localhost:5173

# Deployment used by `npx convex dev`
CONVEX_DEPLOYMENT=

# Comma-separated origins allowed to frame this app and send it navigation
# messages. Leave it EMPTY unless you actually embed the dashboard: an empty
# allowlist denies every inbound navigation, whereas a wrong value would let
# any embedded page drive the signed-in router.
VITE_ALLOWED_EMBED_ORIGINS=

# Server-side only: the email-OTP provider key. Never commit a real value —
# set it as a Convex environment variable instead:
#   npx convex env set FREEBUFF_EMAIL_API_KEY <key>
FREEBUFF_EMAIL_API_KEY=
